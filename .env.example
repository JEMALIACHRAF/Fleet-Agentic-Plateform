# Copy to .env. At least one provider key is required to run for real (no mock provider).

# --- Providers (LiteLLM routes across whatever is set; missing key = provider dropped)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Model groups (skills pick a GROUP: "fast" or "deep"; these map groups -> models)
# Keep deep on Flash while on the free tier so quality skills don't hit paid Pro:
GEMINI_FAST_MODEL=gemini/gemini-2.5-flash
GEMINI_DEEP_MODEL=gemini/gemini-2.5-flash
OPENAI_FAST_MODEL=openai/gpt-4o-mini
OPENAI_DEEP_MODEL=openai/gpt-4o

# --- Reliability budgets
LLM_NUM_RETRIES=2
LLM_TIMEOUT_SECONDS=30
MAX_PROMPT_TOKENS=120000
MAX_CONCURRENT_PIPELINES=8
TOOL_TIMEOUT_SECONDS=8

# --- Langfuse (self-hosted OR cloud). Self-host: http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- BigQuery (blank -> local CSV fallback)
BIGQUERY_PROJECT=
BIGQUERY_DATASET=demo
BIGQUERY_TABLE=vehicle_tracker
