{
  "title": "Fleet Agent Platform \u2014 ADK server (HTTP)",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/s by path",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(fleet_http_requests_total[1m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Requests/s by status",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(fleet_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx) %",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(fleet_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(fleet_http_requests_total[5m])),1)",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "p95 latency by path (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,path) (rate(fleet_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Total requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(fleet_http_requests_total)",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Avg latency by path (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (path)(rate(fleet_http_request_seconds_sum[5m])) / clamp_min(sum by (path)(rate(fleet_http_request_seconds_count[5m])),0.001)",
          "legendFormat": "{{path}}"
        }
      ],
      "id": 6
    },
        {
      "type": "timeseries",
      "title": "Failures/s by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (type) (rate(fleet_node_failures_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ],
      "id": 7
    }
  ],
  "uid": "fleet-adk-http",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s"
}