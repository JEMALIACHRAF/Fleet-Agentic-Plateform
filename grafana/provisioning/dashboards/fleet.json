{
  "title": "Fleet Agent Platform",
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Active pipelines", "gridPos": {"h":6,"w":6,"x":0,"y":0},
     "targets": [{"expr": "fleet_active_pipelines"}]},
    {"type": "timeseries", "title": "Pipeline runs/s by status", "gridPos": {"h":8,"w":9,"x":6,"y":0},
     "targets": [{"expr": "sum by (status) (rate(fleet_pipeline_runs_total[1m]))"}]},
    {"type": "timeseries", "title": "Pipelines rejected/s (rate limit)", "gridPos": {"h":8,"w":9,"x":15,"y":0},
     "targets": [{"expr": "sum by (reason) (rate(fleet_pipeline_rejected_total[1m]))"}]},

    {"type": "timeseries", "title": "Node runs/s by node", "gridPos": {"h":8,"w":12,"x":0,"y":8},
     "targets": [{"expr": "sum by (node) (rate(fleet_node_runs_total[1m]))"}]},
    {"type": "timeseries", "title": "Node failures/s by (node,type)", "gridPos": {"h":8,"w":12,"x":12,"y":8},
     "targets": [{"expr": "sum by (node,type) (rate(fleet_node_failures_total[1m]))"}]},

    {"type": "timeseries", "title": "Node p95 latency by node (s)", "gridPos": {"h":8,"w":12,"x":0,"y":16},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le,node) (rate(fleet_node_duration_seconds_bucket[5m])))"}]},
    {"type": "timeseries", "title": "Pipeline p95 duration (s)", "gridPos": {"h":8,"w":12,"x":12,"y":16},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(fleet_pipeline_duration_seconds_bucket[5m])))"}]}
  ]
}
