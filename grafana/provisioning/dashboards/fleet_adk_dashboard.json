{
  "uid": "fleet-adk-clean",
  "title": "Fleet Agent Platform — ADK",
  "tags": ["fleet", "adk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "type": "row", "title": "Service health (HTTP) — is the server responding?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    { "type": "timeseries", "title": "Requests/s by route",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [{
        "expr": "sum by (path) (rate(fleet_http_requests_total{path=~\"/run_sse|/list-apps|/version|/apps/[^/]+/users/user/sessions\"}[5m]))",
        "legendFormat": "{{path}}" }] },

    { "type": "timeseries", "title": "Error rate 5xx (expected ~0: agent failures return 200)",
      "description": "No 5xx is EXPECTED: ADK handles agent failures internally and returns HTTP 200. HTTP health is not business health.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [{
        "expr": "sum(rate(fleet_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
        "legendFormat": "5xx/s" }] },

    { "type": "timeseries", "title": "p95 latency — /run_sse only (s)",
      "description": "Focused on /run_sse (the actual agent work).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, path) (rate(fleet_http_request_seconds_bucket{path=~\"/run_sse\"}[5m])))",
        "legendFormat": "p95 {{path}}" }] },

    { "type": "row", "title": "Agent health (what actually matters)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },

    { "type": "timeseries", "title": "Failures/s by type",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [{
        "expr": "sum by (type) (rate(fleet_node_failures_total[5m]))",
        "legendFormat": "{{type}}" }] },

    { "type": "bargauge", "title": "Total failures by type (cumulative since start)",
      "description": "Counters are cumulative — they include earlier runs and never reset until the server restarts.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [{
        "expr": "sum by (type) (fleet_node_failures_total)",
        "legendFormat": "{{type}}" }] },

    { "type": "stat", "title": "Agent runs (total)",
      "description": "Proxy: number of /run_sse invocations = number of agent runs.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{
        "expr": "sum(fleet_http_requests_total{path=~\"/run_sse\"}) or vector(0)",
        "legendFormat": "agent runs" }] },

    { "type": "row", "title": "Debugging — where did failures happen?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },

    { "type": "table", "title": "Failures by node + type (cross-reference the run in Langfuse)",
      "description": "The node label shows exactly which node/tool failed. Time column hidden — this is a cumulative count, not an event log.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "targets": [{
        "expr": "sum by (node, type) (fleet_node_failures_total)",
        "format": "table", "instant": true }],
      "transformations": [
        { "id": "organize", "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "count" } } }
      ] }
  ]
}